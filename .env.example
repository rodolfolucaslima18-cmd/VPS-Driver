# ── VPS Drive — Variáveis de Ambiente ────────────────────────────────────────
# Copie este arquivo para .env e preencha os valores antes de iniciar o servidor.

# Caminho no disco onde os arquivos dos usuários serão armazenados
STORAGE_PATH=/data/vps-drive

# Porta que o servidor Express irá escutar
PORT=5000

# URL de conexão com o banco de dados PostgreSQL
# Exemplo: postgresql://usuario:senha@localhost:5432/vpsdrive
DATABASE_URL=

# Chave secreta para assinar as sessões (use uma string aleatória longa)
SESSION_SECRET=

# true se HTTPS estiver ativo (controla o flag Secure nos cookies de sessão)
COOKIE_SECURE=false

# Caminho base da aplicação (deixe / para instalações na raiz)
BASE_PATH=/

# Ambiente de execução
NODE_ENV=production

# IP ou domínio público da VPS (usado para gerar URLs de tokens e callbacks)
VPS_HOST=

# URL do OnlyOffice Document Server para edição de documentos Office no browser.
# Exemplo: http://SEU_IP:8080
# Deixe em branco para desativar o botão "Editar" (o Word/Excel Online continuam disponíveis).
VITE_ONLYOFFICE_URL=
